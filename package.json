    "walkthroughs": [
      {
        "id": "setup",
        "title": "Set up Git'o",
        "description": "Start with local Git in a trusted workspace. Cloud providers are optional.",
        "steps": [
          {
            "id": "open-or-choose-repository",
            "title": "Open a local Git repository",
            "description": "Git'o uses VS Code's bundled Git extension. [Open or choose a Git repository](command:gito.onboarding.openOrChooseRepository) in the native folder picker. Local Git mutations require a trusted workspace; untrusted workspaces may expose read-only inspection. This step completes only after a repository is available.",
            "media": {
              "svg": "media/onboarding/setup.svg",
              "altText": "Git'o setup illustration: a violet-to-blue Git'o mark links a local repository folder to a repository summary card."
            },
            "completionEvents": [
              "onContext:gito.onboarding.localRepositoryAvailable"
            ]
          },
          {
            "id": "open-repository-home",
            "title": "Open Git'o Home",
            "description": "[Open Git'o Home](command:gito.onboarding.openHome) to work with your local repository. No provider connection is required.",
            "media": {
              "svg": "media/onboarding/setup.svg",
              "altText": "Git'o setup illustration: a violet-to-blue Git'o mark links a local repository folder to a repository summary card."
            },
            "completionEvents": [
              "onContext:gito.onboarding.repositoryHomeOpened"
            ]
          },
          {
            "id": "keep-the-bundled-git-engine",
            "title": "Keep VS Code Git enabled",
            "description": "Keep VS Code's bundled `vscode.git` extension enabled: Git'o uses it for repository discovery, state, and ordinary local mutations. CLI-backed features use a configured absolute `git.path`, otherwise the executable exposed by the bundled extension. Native worktree create/remove requires a desktop `file:` repository; remote Extension Host behavior is not live-proven. Source Control can stay visible; hiding it is optional if you prefer less duplicate navigation. [Show optional hiding steps](command:gito.onboarding.showSourceControlSteps), then [confirm it was hidden](command:gito.onboarding.confirmSourceControlHidden), or [keep Source Control visible](command:gito.onboarding.acknowledgeSourceControlVisible). Git'o works either way.",
            "media": {
              "svg": "media/onboarding/setup.svg",
              "altText": "Git'o setup illustration: a violet-to-blue Git'o mark links a local repository folder to a repository summary card."
            },
            "completionEvents": [
              "onContext:gito.onboarding.sourceControlVisibilityPreferenceAcknowledged"
            ]
          },
          {
            "id": "connect-github-optional",
            "title": "Connect GitHub (optional)",
            "description": "Optional GitHub.com pull-request data. [Connect GitHub](command:gito.onboarding.connectGitHub) only when you choose to sign in through VS Code's GitHub provider, or [keep GitHub disconnected](command:gito.onboarding.skipGitHub) to finish setup without cloud data. The provider controls the `repo` and `read:user` session scopes; `repo` can grant access broader than Git'o's read-only operations. Git'o has no account or PAT flow, and in a trusted workspace local Git does not depend on it.",
            "media": {
              "svg": "media/onboarding/setup.svg",
              "altText": "Git'o setup illustration: a violet-to-blue Git'o mark links a local repository folder to a repository summary card."
            },
            "completionEvents": [
              "onContext:gito.onboarding.githubSetupCompleted"
            ]
          },
          {
            "id": "privacy-completion-and-reopening",
            "title": "Finish setup and reopen it later",
            "description": "Git'o has no account, backend, telemetry, analytics, or PAT flow. In a trusted workspace, local Git works when every provider step is skipped; untrusted workspaces may expose read-only inspection only. Setup never opens a browser or sends a provider request automatically. Reopen this walkthrough any time with [Git'o: Open Setup](command:gito.onboarding.openSetup).",
            "media": {
              "svg": "media/onboarding/setup.svg",
              "altText": "Git'o setup illustration: a violet-to-blue Git'o mark links a local repository folder to a repository summary card."
            },
            "completionEvents": [
              "stepSelected"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Git'o",
      "properties": {
        "gito.authorEmails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          },
          "default": [],
          "description": "Additional author email addresses used for commit activity."
        },
        "gito.smartCommit": {
          "type": "boolean",
          "default": false,
          "description": "Offer to commit all changes when no changes are staged."
        },
        "gito.developerDiagnostics": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Enable local Git'o developer diagnostics. Records fixed event names, outcomes, durations, and suppressed-event counts only; never credentials, repository content, commit messages, or full paths. Nothing is uploaded."
        },
        "gito.diff.defaultContextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 1000,
          "description": "Default unchanged lines shown around Git'o diff changes."
        },
        "gito.diff.maxFiles": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 5000,
          "description": "Maximum files retained in a Git'o repository diff."
        },
        "gito.history.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Master gate for Git'o history decorations and CodeLens; history commands remain available regardless."
        },
        "gito.history.blame.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable current-line Git blame decorations only when gito.history.enabled is true."
        },
        "gito.history.codeLens.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable recent history CodeLens only when gito.history.enabled is true."
        },
        "gito.history.maxFileSizeBytes": {
          "type": "number",
          "default": 1000000,
          "minimum": 1,
          "maximum": 10000000,
          "description": "Maximum editor file size inspected by Git'o history features."
        },
        "gito.history.cacheEntryLimit": {
          "type": "number",
          "default": 64,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum Git'o history entries retained in memory."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gito",
          "title": "Git'o",
          "icon": "media/gito.svg"
        }
      ]
    },
    "views": {
      "gito": [
        {
          "id": "gito.navigation",
          "name": "Git'o",
          "type": "tree",
          "when": "gito.workspaceTrusted"
        }
      ]
    }
  },
